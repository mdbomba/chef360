# Shared, non-secret workflow parameters. Copy to chef360.parameters.env.
# Explicit environment variables and command-line arguments override these values.
PROVIDER=azure.com
CHEF360_ENDPOINT=https://chef360.example.com:443
CHEF360_PROFILE=default
CHEF360_COHORT_NAME=all-nodes
CHEF360_COHORT_ID=

# Managed-node and Chef Infra defaults.
CHEF_NODE_USER=chef
CHEF_POLICY_NAME=stig_base
CHEF_POLICY_GROUP=dev

# Azure-specific defaults. Other providers may leave these unused.
RESOURCE_GROUP=rg-chef360-linux
OBJECT_OWNER_PREFIX=chef360
NAME_PREFIX=chef360-sa-linux

# Do not store credentials, tokens, private keys, or signed configurations here.
