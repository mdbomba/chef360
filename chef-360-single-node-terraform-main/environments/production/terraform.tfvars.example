aws_region        = "us-east-1"
environment       = "production"
name_prefix       = "chef360-prod"
topology          = "hyperconverged_ha"
key_name          = "my-ec2-key"
node_ami_id       = "ami-xxxxxxxxxxxxxxxxx"
ssh_cidr_blocks   = ["203.0.113.10/32"]
admin_cidr_blocks = ["203.0.113.10/32"]

enable_route53  = true
route53_zone_id = "Z1234567890ABC"
domain_name     = "example.com"

enable_rds          = true
rds_master_password = "replace-me"

enable_s3        = true
s3_bucket_prefix = "chef360-prod"

common_tags = {
  Application = "chef360"
  Environment = "production"
}
