# Copy to chef360.vars and replace placeholders for local CLI workflows.
# chef360.vars is gitignored because scripts may append runtime IDs and status.
workstation="chef-workstation"
chef360="chef360.example.com"
orgAdmin="org-admin-profile"
tenantAdmin="tenant-admin-profile"
defaultAdmin="default"
capi="https://chef360.example.com"
credFile="$HOME/.chef-platform/credentials"
skillAssemblyName="example-skill-assembly"
skillOverrideName="example-skill-settings"
cohortName="example-cohort"
